<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Space Shooter</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="game-container">
        <!-- HUD -->
        <div id="hud">
            <div class="hud-top">
                <span class="hud-text">SCORE: <span id="scoreVal">0</span></span>
                <span class="hud-text">HIGH: <span id="highScoreVal">0</span></span>
                <span class="hud-text">LVL: <span id="levelVal">1</span></span>
            </div>
            <div class="health-bar-container">
                <div id="health-bar"></div>
            </div>
            <!-- Active Powerup Indicators -->
            <div id="powerup-indicators"></div>
        </div>

        <!-- Game Canvas -->
        <canvas id="gameCanvas"></canvas>

        <!-- UI Overlays -->
        <div id="ui-layer">
            <!-- Start Screen -->
            <div id="start-screen" class="screen">
                <h1 class="title">NEON<br>SHOOTER</h1>
                <p>Move: <kbd>◀</kbd> <kbd>▶</kbd> or <kbd>A</kbd> <kbd>D</kbd></p>
                <p>Shoot: <kbd>SPACE</kbd></p>
                <p>Pause: <kbd>P</kbd></p>
                <button id="start-btn" class="neon-btn">INITIALIZE</button>
            </div>

            <!-- Pause Screen -->
            <div id="pause-screen" class="screen hidden">
                <h1 class="title small-title">PAUSED</h1>
                <button id="resume-btn" class="neon-btn">RESUME</button>
            </div>

            <!-- Game Over Screen -->
            <div id="game-over-screen" class="screen hidden">
                <h1 class="title text-red">SYSTEM FAILURE</h1>
                <h2 class="final-score">FINAL SCORE: <span id="finalScoreVal">0</span></h2>
                <button id="restart-btn" class="neon-btn">REBOOT SYSTEM</button>
            </div>
        </div>

        <!-- Mobile Controls (Visible only on small screens) -->
        <div id="mobile-controls">
            <button id="btn-left" class="control-btn">◀</button>
            <button id="btn-shoot" class="control-btn">◎</button>
            <button id="btn-right" class="control-btn">▶</button>
        </div>
        
        <button id="btn-pause-mobile" class="control-btn small-btn">❚❚</button>
    </div>

    <script src="script.js"></script>
</body>
</html>
